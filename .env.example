# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Приложение с https://my.telegram.org/apps (нужно для чтения каналов)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Строка сессии из `python login.py` (рекомендуется) ИЛИ файл сессии.
# Если задана строка — файл не используется.
TELEGRAM_SESSION=
# TELEGRAM_SESSION_PATH=data/newsbot.session

# Хранилище
DATABASE_PATH=data/newsbot.sqlite3

# Часовой пояс для отметок времени в сообщениях бота (IANA-имя).
# Старое имя DEFAULT_TIMEZONE тоже читается.
DISPLAY_TIMEZONE=Europe/Moscow

# Каналы из .env: через запятую/пробел. Добавляются в БД при старте.
# Пример: SOURCE_CHANNELS=@rian_ru,@telegram
SOURCE_CHANNELS=

# Подписывать новых пользователей на каналы из SOURCE_CHANNELS
AUTO_SUBSCRIBE_ENV_CHANNELS=true

# Как часто опрашивать каналы (секунды, минимум 30).
# Чем меньше интервал, тем быстрее приходят новые посты.
COLLECT_INTERVAL_SECONDS=60

# Присылать пост точной копией: текст + все фото/видео/альбомы.
# Userbot пересылает пост в личный чат с ботом, а бот копирует его подписчикам.
# Нужен работающий сборщик (TELEGRAM_API_ID / TELEGRAM_API_HASH и сессия).
EXACT_COPY_ENABLED=true

# Сколько последних постов забрать при первом добавлении канала.
# Подписчикам из них уйдёт только последний пост, остальные останутся в истории.
INITIAL_FETCH_LIMIT=20

# DEBUG, INFO, WARNING
LOG_LEVEL=INFO
